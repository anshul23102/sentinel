GROQ_API_KEY=your_groq_api_key_here
DATABASE_URL=postgresql://localhost/sentinel
REDIS_URL=redis://localhost:6379/0
# Optional — bypasses rate limiting when sent as the X-API-Key header. Not
# wired into the frontend (a secret shipped to the browser stops being secret);
# use it for your own scripts/curl calls, not for the live demo UI.
ADMIN_API_KEY=
# Comma-separated list of origins allowed to call this API from a browser.
# Add your deployed frontend URL here in production — do not use "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Off by default so the public demo stays interactive for anonymous visitors.
# Set to true/1 to require ADMIN_API_KEY on every scenario/chat/incident-report
# call instead of just rate-limiting them — for a private or staging
# deployment where you want a hard lockdown, not just throttling.
REQUIRE_API_KEY=

# ---------------------------------------------------------------------------
# Anomaly Detection Thresholds (backend/config.py)
# All values are floats. Defaults preserve the existing behavior.
# ---------------------------------------------------------------------------

# Robust (median/MAD) z-score above which a latency spike is flagged (default: 3.5)
SENTINEL_ANOMALY_ZSCORE_THRESHOLD=3.5

# Fraction of 4xx/5xx responses above which an error surge is flagged (default: 0.15 = 15%)
SENTINEL_ANOMALY_ERROR_RATE_THRESHOLD=0.15

# Minimum average latency (ms) required to consider a latency spike (default: 250)
SENTINEL_ANOMALY_LATENCY_THRESHOLD_MS=250

# Z-score below which a previously-firing latency anomaly is cleared (default: 1.5)
SENTINEL_ANOMALY_ZSCORE_CLEAR_THRESHOLD=1.5

# Error-rate fraction below which a previously-firing error anomaly is cleared (default: 0.05 = 5%)
SENTINEL_ANOMALY_ERROR_RATE_CLEAR_THRESHOLD=0.05
