GROQ_API_KEY=your_groq_api_key_here
DATABASE_URL=postgresql://localhost/sentinel
REDIS_URL=redis://localhost:6379/0
# Optional — bypasses rate limiting when sent as the X-API-Key header. Not
# wired into the frontend (a secret shipped to the browser stops being secret);
# use it for your own scripts/curl calls, not for the live demo UI.
ADMIN_API_KEY=
# Comma-separated list of origins allowed to call this API from a browser.
# Add your deployed frontend URL here in production — do not use "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Off by default so the public demo stays interactive for anonymous visitors.
# Set to true/1 to require ADMIN_API_KEY on every scenario/chat/incident-report
# call instead of just rate-limiting them — for a private or staging
# deployment where you want a hard lockdown, not just throttling.
REQUIRE_API_KEY=
