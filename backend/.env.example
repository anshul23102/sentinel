# Groq API key for AI-powered root cause analysis
GROQ_API_KEY=your_api_key_here

# ---------------------------------------------------------------------------
# Anomaly Detection Thresholds
# All values are floats. Defaults preserve the existing hardcoded behavior.
# ---------------------------------------------------------------------------

# Z-score above which a latency spike is flagged (default: 2.5)
SENTINEL_ANOMALY_ZSCORE_THRESHOLD=2.5

# Fraction of 4xx/5xx responses above which an error surge is flagged (default: 0.15 = 15%)
SENTINEL_ANOMALY_ERROR_RATE_THRESHOLD=0.15

# Minimum average latency (ms) required to consider a latency spike (default: 250)
SENTINEL_ANOMALY_LATENCY_THRESHOLD_MS=250

# Z-score below which a previously-firing latency anomaly is cleared (default: 1.5)
SENTINEL_ANOMALY_ZSCORE_CLEAR_THRESHOLD=1.5

# Error-rate fraction below which a previously-firing error anomaly is cleared (default: 0.05 = 5%)
SENTINEL_ANOMALY_ERROR_RATE_CLEAR_THRESHOLD=0.05

